# Plantilla de variables de entorno.
# Copiar este archivo como .env y completar con los valores reales.
# El .env NUNCA se sube al repositorio (esta en .gitignore).

# ---------------------------------------------------------------------------
# OBLIGATORIA
# ---------------------------------------------------------------------------

# Conexion a PostgreSQL.
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
# En Railway se completa sola si se referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:password@localhost:5432/docentes_db

# ---------------------------------------------------------------------------
# OPCIONALES
# ---------------------------------------------------------------------------

# Puerto del servidor. En Railway lo define la plataforma: NO hay que ponerlo.
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Contrasena de acceso a la aplicacion.
# - Vacia o sin definir: la aplicacion NO pide contrasena (uso local).
# - Con un valor: pide la contrasena una vez y guarda la sesion 30 dias.
# IMPORTANTE: definirla SIEMPRE al publicar la aplicacion en internet.
CLAVE_ACCESO=

# Secreto para firmar la cookie de sesion.
# Si se deja vacio se deriva de CLAVE_ACCESO, que ya alcanza.
SESION_SECRETO=

# SSL para la base de datos.
# - false / vacio: conexion sin SSL (tu computadora, o la red interna de Railway)
# - true: conexion cifrada (bases remotas por internet)
DATABASE_SSL=false
